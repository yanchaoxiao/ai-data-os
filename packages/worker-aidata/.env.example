# ── LLM ──
# ⚠️ 原默认走 GLM 滴滴内网不可达，改为 DeepSeek 公网
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── PostgreSQL（复用 ai-xyc 的 PG，独立 database）──
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/worker_aidata

# ── StarRocks / MySQL（内网不可达，降级 local_db）──
STARROCKS_HOST=127.0.0.1
STARROCKS_PORT=9030
STARROCKS_USER=root
STARROCKS_DB=analytics

# ── Spark ──
SPARK_MASTER=local[*]

# ┚─ DataDream MCP（内网不可达，SQL 引擎降级 local_db）──
DATADREAM_MCP_URL=http://127.0.0.1:28582/v1/datadream_mcp_us/datadream_mcp_us
DATADREAM_MCP_TOKEN=your-datadream-token
DATADREAM_PROJECT_CODE=your-project-code

# ── Milvus（milvus-lite 本地文件，无需 Docker）──
MILVUS_URI=./data/milvus.db
MILVUS_COLLECTION=knowledge_base
CATALOG_MILVUS_COLLECTION=table_catalog

# ── Neo4j（ai-xyc docker-compose 容器）──
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Redis（ai-xyc docker-compose 容器）──
REDIS_URL=redis://127.0.0.1:6379/0

# ── Elasticsearch（可选，内存够大才起）──
ES_URL=http://127.0.0.1:9200

# ── Langfuse（可选）──
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_HOST=http://127.0.0.1:3000

# ── 安全 ──
JWT_SECRET_KEY=dev-secret-key-change-in-production
API_KEY=dev-api-key

# ── 服务端口 ──
PORT=3005
GATEWAY_PORT=3005
SEMANTIC_URL=http://127.0.0.1:8011
FUSION_URL=http://127.0.0.1:8002

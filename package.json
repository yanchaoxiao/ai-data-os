{
  "name": "ai-xyc",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "sync": "turbo run start --filter=worker-dealflow",
    "sync:once": "pnpm --filter=worker-dealflow sync:once",
    "seed": "pnpm --filter=worker-dealflow seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
